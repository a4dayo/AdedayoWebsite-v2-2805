{
  "name": "adedayoawojobi",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cd packages/web && bun run dev",
    "build": "cd packages/web && bun run build",
    "build:web": "cd packages/web && bunx vite build",
    "deploy": "cd packages/web && bun run deploy",
    "typecheck": "cd packages/web && bun run typecheck",
    "lint": "oxlint -c .oxlintrc.json packages/web/src",
    "lint:fix": "oxlint -c .oxlintrc.json --fix packages/web/src",
    "db:generate": "cd packages/web && bun run db:generate",
    "db:migrate:local": "cd packages/web && bun run db:migrate:local",
    "db:migrate:remote": "cd packages/web && bun run db:migrate:remote"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxfmt": "0.54.0",
    "oxlint": "1",
    "turbo": "2.9.18",
    "typescript": "5.9.3"
  }
}
